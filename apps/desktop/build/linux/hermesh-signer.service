[Unit]
Description=Hermesh signer: keeps each user's owner key, and signs once they approve
Documentation=https://github.com/hermeshai/hermesh/blob/main/docs/linux.md
Requires=hermesh-signer.socket

[Service]
ExecStart=/opt/Hermesh/bin/hermesh-signer serve
StateDirectory=hermesh-signer
StateDirectoryMode=0700
PrivateTmp=yes
Restart=on-failure

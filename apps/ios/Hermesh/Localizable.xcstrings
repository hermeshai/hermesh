    "Type on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上输入"
          }
        }
      }
    },
    "Type the connection address one of your trusted devices shows (on a Mac: Settings › Account and Devices).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你的一台可信设备上显示的连接地址（在 Mac 上：设置 › 账号与设备）。"
          }
        }
      }
    },
    "Type the digits on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %@ 上的数字"
          }
        }
      }
    },
    "Type the digits on your other device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入其他设备上的数字"
          }
        }
      }
    },
    "Type these digits on the new device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新设备上输入这两位数字"
          }
        }
      }
    },
    "Type these digits on “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「%@」上输入这两位数字"
          }
        }
      }
    },
    "Type your server’s address and the claim code it printed when it started. This iPhone becomes its owner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {

    "Enter a Pairing Code…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入配对码…"
          }
        }
      }
    },
    "Every trusted device can approve requests to connect. If one gets lost, remove it from another (swipe left on it).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台可信设备都能批准连接请求。丢了的设备，在另一台上移除（在它上面左滑）。"
          }
        }
      }
    },

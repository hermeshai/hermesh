    "%@ A trusted device: it can approve requests to connect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可信设备：能批准连接请求。"
          }
        }
      }
    },
    "%@ asks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 问你"
          }
        }
      }
    },
    "%@ is working": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在工作"
          }
        }
      }
    },
    "%@ joined": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已加入"
          }
        }
      }
    },
    "%@ only relays; it can’t approve for you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只转发，替不了你批准"
          }
        }
      }
    },
    "%@ opens a sign-in and approval page; its request then shows up on this iPhone for you to verify and approve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开登录和授权页面；它的连接请求会出现在这台 iPhone 上，由你核对并批准。"
          }
        }
      }
    },
    "%@ sent %lld turns": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 派来 %2$lld 轮"
          }
        }
      }
    },
    "%@ sent no work today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 今天没派活"
          }

            "value": "打开通知"
          }
        }
      }
    },
    "Turned On": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开"
          }
        }
      }
    },
    "Turns": {
      "localizations": {
        "zh-Hans": {

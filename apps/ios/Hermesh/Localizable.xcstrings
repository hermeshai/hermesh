    "Web console": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页控制台"
          }
        }
      }
    },
    "What it can use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能用什么"
          }
        }
      }
    },
    "What “%@” Can Use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」能用什么"
          }
        }
      }
    },
    "When a machine or agent came without your connection address, its terminal shows a pairing code. Its request then opens like any other: compare the verification code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器或 agent 没带你的连接地址时，它的终端会显示一个配对码。输入后，会和其他请求一样弹出批准页面，请核对核对码。"
          }
        }
      }
    },
    "Working Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在干活"
          }
        }
      }
    },
    "Write your answer…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下你的回答…"
          }
        }
      }
    },
    "Your agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Agent"
          }
        }
      }
    },
    "Your answer (secret: only the agent gets it, nothing records it)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答（保密：只交给 agent，不记录）"
          }
        }
      }
    },
    "Your own server": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的服务器"
          }
        }
      }

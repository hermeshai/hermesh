    "Take no new sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停接受新会话"
          }
        }
      }
    },
    "Takes no new sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停接受新会话"
          }
        }
      }

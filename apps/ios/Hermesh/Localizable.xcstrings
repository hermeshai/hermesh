    "Archived: read-only; the worktree is released and the changes stay on the branch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档：只读，worktree 已释放，改动还在分支上。"
          }
        }
      }
    },
    "As the user you code as on that machine. It installs Hermesh, runs it in the background, and shows a verification code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你平时在那台机器上写代码的用户运行。它会安装 Hermesh、在后台运行，并显示一个核对码。"
          }
        }
      }
    },

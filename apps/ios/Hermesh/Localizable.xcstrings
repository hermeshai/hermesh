          }
        }
      }
    },
    "Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "View All Sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看全部会话"
          }
        }
      }
    },
    "View Options": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视图选项"
          }
        }
      }
    },
    "Waiting for approval…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待批准…"
          }
        }
      }
    },
    "Waiting for that machine to connect…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待那台机器连上来…"
          }
        }
      }
    },
    "Waiting for you · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你回答 · %@"
          }
        }
      }
    },
    "Waits for a turn of its own": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排队等它自己的一轮"

    "%@ %@": {
      "shouldTranslate": false
    },
    "%@ %lld%%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld%%"
          }
        }
      }
    },
    "%@ A trusted device: it can approve requests to connect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可信设备：能批准连接请求。"
          }
        }
      }
    },
    "%@ asks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 问你"
          }
        }
      }
    },
    "%@ is working": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在工作"
          }
        }
      }
    },
    "%@ opens a sign-in and approval page; its request then shows up on this iPhone for you to verify and approve.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会打开登录和授权页面；它的连接请求会出现在这台 iPhone 上，由你核对并批准。"
          }
        }
      }
    },
    "%@ · %@": {
      "shouldTranslate": false
    },
    "%@ · %@ · %@": {
      "shouldTranslate": false
    },
    "%@ · %@/%@": {
      "shouldTranslate": false
    },

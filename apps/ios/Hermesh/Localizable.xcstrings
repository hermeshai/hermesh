    "**%@ is offline**; its sessions can’t be shown for now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 离线了**，它上面的会话暂时看不到"
          }
        }
      }
    },
    "**%@ isn’t responding**; its sessions may be missing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@ 暂时没有回应**，它上面的会话可能没列全"

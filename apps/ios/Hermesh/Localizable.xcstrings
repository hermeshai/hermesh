      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量"
          }
        }
      }
    },
    "Usage over the last %lld weeks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 %lld 周的用量"
          }
        }
      }
    },
    "Use Your Own Server…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自己的服务器…"
          }
        }
      }
    },
    "Valid for": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效期"
          }
        }
      }
    },
    "Valid until %@ · %lld days left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效期至 %1$@ · 还剩 %2$lld 天"
          }
        }
      }
    },
    "Verification code": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对码"
          }
        }
      }
    },
    "Verification code %@": {

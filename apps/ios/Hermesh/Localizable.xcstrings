      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」经由 %2$@ 连接：%3$@ 保管这个 agent 的密钥，可以在这个范围内代表它操作，并能看到它触及的会话。"
          }
        }
      }
    },
    "“%@” is a trusted device now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已成为可信设备"
          }

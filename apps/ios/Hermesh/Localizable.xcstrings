    "1. On that machine, run": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在那台机器上运行"
          }
        }
      }
    },
    "1. On the other device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在另一台设备上"
          }
        }
      }
    },
    "1. Run this in that machine’s terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 在那台机器的终端里运行"
          }
        }
      }
    },

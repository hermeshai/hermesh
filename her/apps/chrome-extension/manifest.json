{
  "manifest_version": 3,
  "name": "Hermesh",
  "description": "__MSG_extDescription__",
  "version": "0.2.1",
  "default_locale": "en",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "identity",
    "identity.email"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hermesh",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

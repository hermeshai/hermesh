+    #[test]
+    fn clustered_horizontal_bars_and_legend_follow_powerpoint_series_order() {
+        let data = source(&[1.0]);
+        for grouped_chart in [false, true] {
+            for legend_position in ["bottom", "right"] {
+                let mut chart = PlotChart {
+                    chart_type: "bar",
+                    legend: Some(PlotLegend {
+                        overlay: false,
+                        position: Some(legend_position),
+                        visible: Some(true),
+                    }),
+                    ..PlotChart::default()
+                };
+                let entries = vec![series("North", &data), series("South", &data)];
+                if grouped_chart {
+                    chart.plot_groups = vec![group("bar", entries)];
+                } else {
+                    chart.series = entries;
+                }
+                let ops = plot_chart(&chart, rect());
+                let bars = bars(&ops);
+                assert_eq!(bars.len(), 2);
+                assert!(
+                    bars[0].1 > bars[1].1,
+                    "first series should be below the second: {bars:?}"
+                );
+                let north = text_at(&ops, "North");
+                let south = text_at(&ops, "South");
+                if legend_position == "bottom" {
+                    assert!(south.1 < north.1);
+                } else {
+                    assert!(south.2 < north.2);
+                }
+            }
+        }
     }
 

    "linux-aarch64": {"url":"https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli/releases/download/v1.0.66/dws-linux-arm64.tar.gz", "sha256":"4d6bd477d5b47d2595baa9adf718e3d38f6d2532614873e4f670cd84adf88096", "entry":"dws"},
    "linux-x86_64": {"url":"https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli/releases/download/v1.0.66/dws-linux-amd64.tar.gz", "sha256":"27cd2821e1f6523d1eeaf5688c23502bddbdd858cf82e32c197853065418bef8", "entry":"dws"}

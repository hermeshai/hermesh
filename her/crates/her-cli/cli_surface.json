{
  "_about": "What the command line offers, for src/cli_shape.rs (docs/kernel/standalone-cli-design.md §4). A test fails when the code and this file disagree, so adding a command, a flag or an environment variable means writing down what it is. Entries that no longer match anything fail too.",
  "short_flags": {
    "h": "help",
    "V": "version",
    "v": "version",
    "c": "override a configuration value, as git -c does",
    "m": "model"
  },
  "verbs": ["list", "get", "add", "remove", "enable", "disable", "set", "unset", "hide", "unhide", "login", "logout", "install", "uninstall", "check", "status"],
  "verb_exceptions": {
    "browser extension": "A group, not an action.",
    "protocol schema": "A noun with a single job: printing the schema.",
    "config path": "A noun with a single job: printing where the file is.",
    "web-search set-key": "Takes a secret from standard input, not a value in the arguments.",
    "sessions rename": "The word every tool uses; `set` would need a key."
  },
  "commands": {
    "_about": "Every visible command. json: it prints data and takes --json. always_json: it prints only JSON. no_data: it acts or serves; a setter prints one line naming the value and the file.",
    "json": [
      "exec",
      "sessions",
      "sessions list",
      "tools",
      "config",
      "config list",
      "config get",
      "web-search status",
      "web-search check",
      "models",
      "models list",
      "models check",
      "status",
      "doctor",
      "skills",
      "skills list",
      "mcp",
      "mcp list",
      "mcp get",
      "browser extension status",
      "upgrade"
    ],
    "always_json": {
      "protocol schema": "The schema is JSON."
    },
    "no_data": [
      "login",
      "logout",
      "sessions remove",
      "sessions rename",
      "config set",
      "config unset",
      "config path",
      "web-search",
      "web-search set-key",
      "install",
      "uninstall",
      "models hide",
      "models unhide",
      "skills add",
      "skills remove",
      "skills enable",
      "skills disable",
      "browser",
      "browser install",
      "browser extension",
      "browser extension install",
      "browser extension uninstall",
      "trust",
      "mcp add",
      "mcp login",
      "mcp logout",
      "mcp remove",
      "mcp enable",
      "mcp disable",
      "resume",
      "serve",
      "acp",
      "protocol",
      "completion"
    ]
  },
  "run_options": {
    "_about": "One row per option a run can set, named on every surface. Names may differ by surface, but each one is written here. sample is a valid value, used to check the configuration key.",
    "model": { "flag": "--model", "config": "model", "sample": "provider/model-id", "env": "HER_MODEL", "rpc": "model", "acp": "model" },
    "thinking": { "flag": "--thinking", "config": "thinking", "sample": "low", "rpc": "thinking", "acp": "thinking" },
    "permission_mode": { "flag": "--permission-mode", "config": "permission_mode", "sample": "manual", "env": "HER_PERMISSION_MODE", "rpc": "permission_mode", "acp": "permission_mode" },
    "cwd": { "flag": "--cwd", "rpc": "cwd" },
    "max_turns": { "flag": "--max-turns", "config": "max_turns", "sample": "3" },
    "tools": { "flag": "--tools", "config": "tools.enabled", "sample": "[\"read\"]" },
    "add_dir": { "flag": "--add-dir", "config": "extra_writable_roots", "sample": "[\"/tmp\"]", "rpc": "extra_roots" }
  },
  "exec_flags": {
    "_about": "The other flags of her exec: they are about this one command, not a run's settings.",
    "--config": "Sets any configuration value for this run.",
    "--mcp-config": "Adds MCP servers for this run.",
    "--help": "Help.",
    "--resume": "Which session to continue.",
    "--no-save": "Whether to keep a log of this run.",
    "--dangerously-skip-permissions": "Shortcut for --permission-mode bypass-permissions, named as the warning it is.",
    "--output": "What to print.",
    "--json": "Same as --output json, as on every command that prints data.",
    "--ops-stdin": "Read operations from stdin.",
    "--output-last-message": "Where to write the last message.",
    "--image": "Part of this task's input."
  },
  "deprecated_flags": {
    "--approval": { "replacement": "--permission-mode", "remove_in": "0.3.0" }
  },
  "env": {
